{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalCYOA Game File",
  "description": "Data detailing a Choose Your Own Adventure (CYOA) game",
  "type": "object",
  "$defs": {
    "choice": {
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "next": { "type": "string" },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/choiceAction"
          },
          "minimum": 1
        }
      },
      "required": ["content", "next"]
    },
    "choiceAction": {
      "type": "object",
      "properties": {
        "type": { "type": "string" }
      },
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "AddItem" },
            "item": { "type": "string" },
            "amount": { "type": "number" }
          },
          "required": ["type", "item"]
        }
      ]
    },
    "condition": {
      "type": "object",
      "properties": {
        "type": { "type": "string" }
      },
      "anyOf": [
        {
          "properties": {
            "type": { "const": "ItemCount" },
            "item": { "type": "string" }
          },
          "anyOf": [
            {
              "properties": {
                "min": { "type": "number" }
              },
              "required": ["min"]
            },
            {
              "properties": {
                "max": { "type": "number" }
              },
              "required": ["max"]
            }
          ],
          "required": ["type", "item"]
        }
      ],
      "required": ["type"]
    }
  },
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "version": { "type": "string" }
      },
      "required": ["title", "author", "version"]
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "content": { "type": "string" },
          "choices": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/choice"
            }
          }
        },
        "required": ["content", "choices"]
      }
    }
  }
}
